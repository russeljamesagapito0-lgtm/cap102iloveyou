diff --git a/superadmin-changes/sql/superadmin.sql b/superadmin-changes/sql/superadmin.sql
index 5970d0b..7b6aca3 100644
--- a/superadmin-changes/sql/superadmin.sql
+++ b/superadmin-changes/sql/superadmin.sql
@@ -53,3 +53,13 @@ create policy a_ins on public.audit_log for insert
 
 -- 5. Create the one superadmin: add the user in Authentication -> Users, then run (replace email):
 -- update public.profiles set role = 'superadmin' where email = 'superadmin@example.com';
+
+-- 6. Revoke every session of a user (called by manage-admins on suspend and password reset).
+--    admin.signOut() takes a JWT, not a user id, so sessions are cleared here instead.
+--    Deleting auth.sessions also deletes the refresh tokens (cascade). service_role only.
+create or replace function public.revoke_user_sessions(uid uuid) returns void
+language sql security definer set search_path = '' as $$
+  delete from auth.sessions where user_id = uid;
+$$;
+revoke all on function public.revoke_user_sessions(uuid) from public, anon, authenticated;
+grant execute on function public.revoke_user_sessions(uuid) to service_role;
diff --git a/superadmin-changes/supabase/functions/manage-admins/index.ts b/superadmin-changes/supabase/functions/manage-admins/index.ts
index 7ff756f..d881c16 100644
--- a/superadmin-changes/supabase/functions/manage-admins/index.ts
+++ b/superadmin-changes/supabase/functions/manage-admins/index.ts
@@ -77,11 +77,29 @@ Deno.serve(async (req) => {
     if (error) return json({ error: error.message }, 400)
 
     await sb.from('profiles').update({ status: suspend ? 'suspended' : 'active' }).eq('id', id)
-    if (suspend) await sb.auth.admin.signOut(id, 'global') // revoke refresh tokens
+    if (suspend) await sb.rpc('revoke_user_sessions', { uid: id }) // revoke refresh tokens
 
     await audit(`admin.${action}`, id, { email: target.email })
     return json({ ok: true })
   }
 
+  // 5. Reset an admin's password (active or suspended admins)
+  if (action === 'reset_password') {
+    const { id } = body
+    const password = String(body.password ?? '')
+    if (!id) return json({ error: 'Missing id' }, 400)
+    if (password.length < 8) return json({ error: 'Password must be at least 8 characters' }, 400)
+
+    const { data: target } = await sb.from('profiles').select('role,email').eq('id', id).maybeSingle()
+    if (target?.role !== 'admin') return json({ error: 'Target is not an admin account' }, 400)
+
+    const { error } = await sb.auth.admin.updateUserById(id, { password })
+    if (error) return json({ error: error.message }, 400)
+
+    const { error: rErr } = await sb.rpc('revoke_user_sessions', { uid: id }) // force re-login
+    await audit('admin.reset_password', id, { email: target.email, sessions_revoked: !rErr })
+    return json({ ok: true, sessions_revoked: !rErr })
+  }
+
   return json({ error: 'Unknown action' }, 400)
 })
