diff --git a/src/utils/accountStatus.js b/src/utils/accountStatus.js
new file mode 100644
index 0000000..1970dac
--- /dev/null
+++ b/src/utils/accountStatus.js
@@ -0,0 +1,29 @@
+// src/utils/accountStatus.js
+// Reads profiles.status ('active' | 'suspended') for the signed-in user.
+// Admins set this from the admin panel (Users -> Suspend user).
+import { supabase } from './supabaseClient';
+
+export const SUSPENDED_TITLE = 'Account Suspended';
+export const SUSPENDED_MESSAGE =
+  'Your account has been suspended by an administrator, so you can’t log in right now. ' +
+  'If you think this is a mistake, please contact RootCare support.';
+
+/**
+ * Returns 'active' | 'suspended', or null if the status couldn't be checked
+ * (network/RLS error). Callers decide whether to fail open or closed.
+ */
+export const fetchAccountStatus = async (userId) => {
+  if (!userId) return null;
+  try {
+    const { data, error } = await supabase
+      .from('profiles')
+      .select('status')
+      .eq('id', userId)
+      .maybeSingle();
+    if (error) return null;
+    // No profile row (or no status) = nothing to suspend.
+    return data?.status === 'suspended' ? 'suspended' : 'active';
+  } catch (_) {
+    return null;
+  }
+};
diff --git a/supabase/sql/suspended_users.sql b/supabase/sql/suspended_users.sql
new file mode 100644
index 0000000..77dcb5a
--- /dev/null
+++ b/supabase/sql/suspended_users.sql
@@ -0,0 +1,23 @@
+-- Server-side enforcement for suspended accounts.
+-- The app signs suspended users out, but a token that was already issued stays valid
+-- until it expires, so block writes in the database too. Run once in the SQL editor.
+
+create or replace function public.is_account_active() returns boolean
+language sql stable security definer set search_path = public as $$
+  select coalesce((select status = 'active' from public.profiles where id = auth.uid()), true);
+$$;
+
+-- scans: suspended users can't add or edit scans
+drop policy if exists s_ins on public.scans;
+create policy s_ins on public.scans for insert
+  with check (user_id = auth.uid() and public.is_account_active());
+
+drop policy if exists s_own_upd on public.scans;
+create policy s_own_upd on public.scans for update
+  using (user_id = auth.uid() and public.is_account_active())
+  with check (user_id = auth.uid() and public.is_account_active());
+
+-- feedback: suspended users can't submit
+drop policy if exists f_ins on public.feedback;
+create policy f_ins on public.feedback for insert
+  with check (user_id = auth.uid() and public.is_account_active());
